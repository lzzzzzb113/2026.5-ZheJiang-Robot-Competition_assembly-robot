void bayes_update(BayesFilter *f, ObsType obs, float confidence) {
    float new_belief[REAL_TYPE_COUNT];
    float sum = 0.0f;

    // 贝叶斯更新：后验 ∝ 似然 × 先验
    for (int real = 0; real < REAL_TYPE_COUNT; real++) {
        float like = likelihood[obs][real];
        // confidence暂时预留，后面可以用来缩放似然:
        // like = like * confidence + 均匀分布 * (1 - confidence)
        // 表示"摄像头越不确定，越接近瞎猜"
        new_belief[real] = like * f->belief[real];
        sum += new_belief[real];
    }

    // 归一化
    if (sum > 0.0f) {
        float inv_sum = 1.0f / sum;
        for (int i = 0; i < REAL_TYPE_COUNT; i++) {
            f->belief[i] = new_belief[i] * inv_sum;
        }
    } else {
        // 数值异常，重置为均匀分布
        bayes_reset(f);
    }
}

