    { 0.02, 0.02, 0.35, 0.55, 0.02, 0.04 },  // OBS_PT (明确报塑料TI)
    { 0.02, 0.02, 0.04, 0.02, 0.55, 0.35 },  // OBS_MS (明确报金属SAN)
